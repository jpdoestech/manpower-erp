# Local development only. Set a unique local password before starting Compose.
POSTGRES_USER=manpower
POSTGRES_DB=manpower
POSTGRES_PASSWORD=
# Native API/migrator/test connection; export explicitly in native terminals.
# Match the password above (URL-encode special characters).
# Compose passes POSTGRES_* components to the API/migrator; this URL is native-only.
DATABASE_URL=postgresql://manpower:SET_LOCAL_PASSWORD@127.0.0.1:5432/manpower
